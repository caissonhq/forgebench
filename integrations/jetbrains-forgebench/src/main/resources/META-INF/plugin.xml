<idea-plugin>
  <id>dev.forgebench.jetbrains</id>
  <name>ForgeBench</name>
  <vendor email="hello@forgebench.dev" url="https://forgebench.dev">ForgeBench</vendor>
  <description><![CDATA[
    <p>Merge-risk review for AI-generated diffs — powered by the local ForgeBench CLI.</p>
    <ul>
      <li>Findings tool window with posture summary</li>
      <li>Onboarding wizard (doctor, demo, status)</li>
      <li>Review diff + task, open reports and repair prompts</li>
      <li>Validate guardrails, policy tests, enterprise init</li>
    </ul>
    <p>Requires <code>forgebench</code> on PATH. Install: <code>pipx install forgebench</code></p>
    <p><a href="https://forgebench.dev/docs/installation/">Installation guide</a></p>
  ]]></description>
  <change-notes><![CDATA[
    <ul>
      <li>1.2 — Marketplace listing polish, install guidance links</li>
      <li>1.1 — Onboarding wizard, status, enterprise init</li>
      <li>1.0 — Initial tool window and review actions</li>
    </ul>
  ]]></change-notes>
  <tags>code-review,ai,merge-risk,quality,guardrails</tags>
  <depends>com.intellij.modules.platform</depends>
  <extensions defaultExtensionNs="com.intellij">
    <toolWindow id="ForgeBench"
                anchor="right"
                factoryClass="dev.forgebench.jetbrains.ForgeBenchToolWindowFactory"/>
    <projectService serviceImplementation="dev.forgebench.jetbrains.ForgeBenchSettings"/>
  </extensions>
  <actions>
    <group id="ForgeBench.Group" text="ForgeBench" popup="true">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
      <action id="ForgeBench.Onboarding"
              class="dev.forgebench.jetbrains.ForgeBenchOnboardingAction"
              text="Onboarding Wizard"
              description="Run doctor, demo, and status checklist"/>
      <action id="ForgeBench.ReviewDiff"
              class="dev.forgebench.jetbrains.ForgeBenchReviewAction"
              text="Review Diff + Task"
              description="Run forgebench review on selected diff and task files"/>
      <action id="ForgeBench.OpenReport"
              class="dev.forgebench.jetbrains.ForgeBenchOpenReportAction"
              text="Open Markdown Report"
              description="Open forgebench-report.md"/>
      <action id="ForgeBench.Repair"
              class="dev.forgebench.jetbrains.ForgeBenchRepairAction"
              text="Open Repair Prompt"
              description="Open repair-prompt.md for your coding agent"/>
      <action id="ForgeBench.Status"
              class="dev.forgebench.jetbrains.ForgeBenchStatusAction"
              text="Show Status"
              description="Run forgebench status"/>
      <action id="ForgeBench.Init"
              class="dev.forgebench.jetbrains.ForgeBenchInitAction"
              text="Init / Enterprise Kit"
              description="Run forgebench init or init --enterprise"/>
      <action id="ForgeBench.Validate"
              class="dev.forgebench.jetbrains.ForgeBenchValidateAction"
              text="Validate Guardrails"
              description="Run forgebench validate --strict"/>
      <action id="ForgeBench.PolicyTest"
              class="dev.forgebench.jetbrains.ForgeBenchPolicyTestAction"
              text="Run Policy Tests"
              description="Run forgebench policy test"/>
      <action id="ForgeBench.ExportDashboard"
              class="dev.forgebench.jetbrains.ForgeBenchExportDashboardAction"
              text="Export Policy Dashboard"
              description="Run forgebench dashboard"/>
    </group>
  </actions>
</idea-plugin>