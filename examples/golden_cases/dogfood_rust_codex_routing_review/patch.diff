+pub(crate) fn log_codex_stream_completion_summary(
+    tag: &str,
+    events: &[Value],
+    upstream_status: u16,
+    request_model: &str,
+    latency_ms: u64,
+    first_event_ms: Option<u64>,
+) {
+    let Some(event) = events.iter().find(|event| {
+        event
+            .get("type")
+            .and_then(Value::as_str)
+            .is_some_and(|event_type| event_type == "response.completed")
+    }) else {
+        log::info!(
+            "[{tag}] Codex stream ended without response.completed: request_model={request_model}, upstream_status={upstream_status}, latency_ms={latency_ms}, first_event_ms={first_event_ms:?}, collected_events={}",
+            events.len()
+        );
+        return;
+    };
+
+    let response = event.get("response").unwrap_or(event);
+    let response_model = response
+        .get("model")
+        .and_then(Value::as_str)
+        .unwrap_or("unknown");
+    let response_status = response
+        .get("status")
+        .and_then(Value::as_str)
+        .unwrap_or("unknown");
+    let incomplete_reason = response
+        .pointer("/incomplete_details/reason")
+        .and_then(Value::as_str)
+        .unwrap_or("none");
+    let error_type = response
+        .pointer("/error/type")
+        .and_then(Value::as_str)
+        .unwrap_or("none");
+    let error_code = response
+        .pointer("/error/code")
+        .and_then(Value::as_str)
+        .unwrap_or("none");
+    let usage = response.get("usage");
+    let input_tokens = usage
+        .and_then(|u| u.get("input_tokens"))
+        .and_then(Value::as_u64)
+        .unwrap_or(0);
+    let output_tokens = usage
+        .and_then(|u| u.get("output_tokens"))
+        .and_then(Value::as_u64)
+        .unwrap_or(0);
+    let cached_tokens = usage
+        .and_then(|u| u.pointer("/input_tokens_details/cached_tokens"))
+        .and_then(Value::as_u64)
+        .unwrap_or(0);
+    let reasoning_tokens = usage
+        .and_then(|u| u.pointer("/output_tokens_details/reasoning_tokens"))
+        .and_then(Value::as_u64)
+        .unwrap_or(0);
+    let output_summary = summarize_codex_output_items(response.get("output"));
+
+    log::info!(
+        "[{tag}] Codex response.completed summary: request_model={request_model}, response_model={response_model}, response_status={response_status}, incomplete_reason={incomplete_reason}, error_type={error_type}, error_code={error_code}, output_items={output_summary}, input_tokens={input_tokens}, output_tokens={output_tokens}, cached_tokens={cached_tokens}, reasoning_tokens={reasoning_tokens}, upstream_status={upstream_status}, latency_ms={latency_ms}, first_event_ms={first_event_ms:?}"
+    );
+}
+
+fn summarize_codex_output_items(output: Option<&Value>) -> String {
+    let Some(items) = output.and_then(Value::as_array) else {
+        return "none".to_string();
+    };
+    if items.is_empty() {
+        return "empty".to_string();
+    }
+
+    let mut counts = BTreeMap::<String, usize>::new();
+    for item in items {
+        let item_type = item
+            .get("type")
+            .and_then(Value::as_str)
+            .unwrap_or("unknown");
+        let item_status = item.get("status").and_then(Value::as_str).unwrap_or("none");
+        let key = format!("{item_type}:{item_status}");
+        *counts.entry(key).or_default() += 1;
+    }
+
+    counts
+        .into_iter()
+        .map(|(key, count)| format!("{key}x{count}"))
+        .collect::<Vec<_>>()
+        .join(",")
+}
