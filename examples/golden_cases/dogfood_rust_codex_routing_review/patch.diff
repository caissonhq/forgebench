+    pub(crate) fn infer_chat_name_from_arguments(&self, arguments: &str) -> Option<String> {
+        let args = serde_json::from_str::<Value>(arguments).ok()?;
+        let args = args.as_object()?;
+        if args.is_empty() {
+            return None;
+        }
+
+        let arg_keys = args.keys().map(String::as_str).collect::<Vec<_>>();
+        let mut best_match: Option<(String, usize)> = None;
+        let mut has_tie = false;
+
+        for chat_tool in &self.chat_tools {
+            let Some(function) = chat_tool.get("function") else {
+                continue;
+            };
+            let Some(chat_name) = function
+                .get("name")
+                .and_then(|value| value.as_str())
+                .map(str::trim)
+                .filter(|value| !value.is_empty())
+            else {
+                continue;
+            };
+            let parameters = function.get("parameters").unwrap_or(&Value::Null);
+            let properties = parameters
+                .get("properties")
+                .and_then(|value| value.as_object());
+            let required = parameters
+                .get("required")
+                .and_then(|value| value.as_array())
+                .map(|items| {
+                    items
+                        .iter()
+                        .filter_map(|item| item.as_str())
+                        .collect::<Vec<_>>()
+                })
+                .unwrap_or_default();
+
+            if properties.is_none() && required.is_empty() {
+                continue;
+            }
+            if required
+                .iter()
+                .any(|required_key| !arg_keys.iter().any(|key| *key == *required_key))
+            {
+                continue;
+            }
+
+            let property_matches = properties
+                .map(|properties| {
+                    arg_keys
+                        .iter()
+                        .filter(|key| {
+                            properties
+                                .keys()
+                                .any(|property_key| property_key.as_str() == **key)
+                        })
+                        .count()
+                })
+                .unwrap_or(0);
